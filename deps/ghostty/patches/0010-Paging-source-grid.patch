+    /// A source grid is consumed in VT stream order on the main thread.
+    /// Keep queued physical/font resizes from moving the parser across that
+    /// boundary; backend resize callbacks continue reporting physical intent.
+    export fn ghostty_surface_set_source_grid(surface: *Surface, cols: u16, rows: u16) bool {
+        if (surface.termio_backend != .host_managed or cols == 0 or rows == 0 or
+            cols > 1000 or rows > 1000 or @as(usize, cols) * rows > 262144) return false;
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        const io = &core.io;
+        const changed = io.terminal.cols != cols or io.terminal.rows != rows;
+        if (changed) {
+            // The source stream owns shell redraw. A mirror must retain its
+            // prompt/input rows until that stream actually changes them.
+            const prompt_redraw = io.terminal.flags.shell_redraws_prompt;
+            io.terminal.flags.shell_redraws_prompt = .false;
+            defer io.terminal.flags.shell_redraws_prompt = prompt_redraw;
+            io.terminal.resize(io.alloc, .{
+                .cols = cols,
+                .rows = rows,
+                .cell_size_px = .{ .width = core.size.cell.width, .height = core.size.cell.height },
+            }) catch return false;
+        }
+        io.terminal.width_px = std.math.mul(u32, cols, core.size.cell.width) catch std.math.maxInt(u32);
+        io.terminal.height_px = std.math.mul(u32, rows, core.size.cell.height) catch std.math.maxInt(u32);
+        io.host_managed_grid = .{ .columns = cols, .rows = rows };
+        if (changed and io.terminal.modes.get(.in_band_size_reports))
+            io.mailbox.send(.{ .size_report = .mode_2048 }, core.renderer_state.mutex);
+        io.terminal.flags.dirty.clear = true;
+        io.mailbox.notify();
+        io.renderer_wakeup.notify() catch {};
+        return true;
+    }
+
+    /// Leave source-controlled parsing when the host falls back to a legacy
+    /// transport. The host orders this call after prior queued output.
+    export fn ghostty_surface_clear_source_grid(surface: *Surface) bool {
+        if (surface.termio_backend != .host_managed) return false;
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        const io = &core.io;
+        if (io.host_managed_grid == null) return true;
+        const grid = core.size.grid();
+        const changed = io.terminal.cols != grid.columns or io.terminal.rows != grid.rows;
+        if (changed) {
+            io.terminal.resize(io.alloc, .{
+                .cols = grid.columns,
+                .rows = grid.rows,
+                .cell_size_px = .{ .width = core.size.cell.width, .height = core.size.cell.height },
+            }) catch return false;
+        }
+        io.terminal.width_px = std.math.mul(u32, grid.columns, core.size.cell.width) catch std.math.maxInt(u32);
+        io.terminal.height_px = std.math.mul(u32, grid.rows, core.size.cell.height) catch std.math.maxInt(u32);
+        io.host_managed_grid = null;
+        if (changed and io.terminal.modes.get(.in_band_size_reports))
+            io.mailbox.send(.{ .size_report = .mode_2048 }, core.renderer_state.mutex);
+        io.terminal.flags.dirty.clear = true;
+        io.mailbox.notify();
+        io.renderer_wakeup.notify() catch {};
+        return true;
+    }
+
