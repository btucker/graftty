+    export fn graftty_probe_surface_grid_matches(surface: *Surface, cols: u16, rows: u16) bool {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        return core.io.terminal.cols == cols and core.io.terminal.rows == rows;
+    }
+
+    export fn graftty_probe_surface_snapshot_offset(surface: *Surface) usize {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        const snapshot = surface.probe_snapshot orelse return 0;
+        return snapshot.source.seek;
+    }
+
+    // -1: failed, 0: complete, 1: consumed page, 2: recovery required.
+    export fn graftty_probe_surface_snapshot_next(surface: *Surface, rows: *usize) c_int {
+        rows.* = 0;
+        const snapshot = surface.probe_snapshot orelse return -1;
+        if (snapshot.failed) return -1;
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        // 2 is a recoverable history condition, not a decoded zero-row page.
+        // The decoder leaves the pending record and live terminal untouched.
+        const progress = snapshot.decoder.nextAtOriginalWidth(core.io.alloc, &core.io.terminal) catch |err| {
+            if (err == error.HistoryRequiresRecovery) return 2;
+            snapshot.failed = true;
+            return -1;
+        } orelse return 0;
+        rows.* = progress.rows;
+        core.io.terminal.flags.dirty.clear = true;
+        core.io.terminal_stream.handler.queueRender() catch {};
+        return 1;
+    }
+
