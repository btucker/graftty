+    // Experimental symbols, intentionally absent from the public header.
+    // Caller must use a fresh surface, call on the main thread, and serialize
+    // writes, page imports, and teardown. This is not a production wire API.
+    export fn graftty_probe_surface_snapshot_ready(
+        surface: *Surface,
+        ptr: [*]const u8,
+        len: usize,
+    ) bool {
+        if (surface.termio_backend != .host_managed or surface.probe_snapshot != null)
+            return false;
+        if (len == 0 or len > 8 * 1024 * 1024) return false;
+        const core = &surface.core_surface;
+        if (core.search != null or core.inspector != null) return false;
+        const alloc = surface.app.core_app.alloc;
+        const snapshot = Surface.ProbeSnapshot.create(alloc, ptr[0..len]) catch return false;
+        var decoded = snapshot.decoder.ready(alloc, global.io(), .{
+            .max_continuation_bytes = 1024 * 1024,
+        }) catch {
+            snapshot.destroy(alloc);
+            return false;
+        };
+        defer decoded.deinit(alloc);
+
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        const io = &core.io;
+        if (io.terminal.cols != decoded.terminal.?.cols or
+            io.terminal.rows != decoded.terminal.?.rows)
+        {
+            snapshot.destroy(alloc);
+            return false;
+        }
+        const old_handler = &io.terminal_stream.handler;
+        const handler: @import("../termio/stream_handler.zig").StreamHandler = .{
+            .alloc = io.alloc,
+            .size = &io.size,
+            .terminal = &io.terminal,
+            .termio_mailbox = &io.mailbox,
+            .surface_mailbox = io.surface_mailbox,
+            .renderer_state = io.renderer_state,
+            .renderer_mailbox = io.renderer_mailbox,
+            .renderer_wakeup = io.renderer_wakeup,
+            .enquiry_response = old_handler.enquiry_response,
+            .osc_color_report_format = old_handler.osc_color_report_format,
+            .clipboard_write = old_handler.clipboard_write,
+            .clipboard_write_limit = old_handler.clipboard_write_limit,
+        };
+        core.mouse.selection_gesture.reset(&io.terminal);
+        io.terminal_stream.deinit();
+        io.terminal.deinit(io.alloc);
+        io.terminal = decoded.toOwned();
+        io.terminal.width_px = io.terminal.cols * io.size.cell.width;
+        io.terminal.height_px = io.terminal.rows * io.size.cell.height;
+        io.terminal_stream = .init(.{ .allocator = io.alloc, .handler = handler });
+        // Snapshot decode restores mode bits without StreamHandler.setMode's
+        // I/O-thread side effects. Restore those before any continuation or
+        // new input can depend on them.
+        io.mailbox.send(.{ .linefeed_mode = io.terminal.modes.get(.linefeed) }, core.renderer_state.mutex);
+        if (io.terminal.modes.get(.synchronized_output))
+            io.mailbox.send(.{ .start_synchronized_output = {} }, core.renderer_state.mutex);
+        switch (decoded.continuation) {
+            .ground => {},
+            .bytes => |bytes| io.terminal_stream.nextSlice(bytes),
+        }
+        io.terminal.flags.dirty.clear = true;
+        surface.probe_snapshot = snapshot;
