diff --git a/src/terminal/snapshot/attachment.zig b/src/terminal/snapshot/attachment.zig
new file mode 100644
index 0000000000000000000000000000000000000000..67bed3775c6fea2ebaaeecf2886bf34be8c08195
--- /dev/null
+++ b/src/terminal/snapshot/attachment.zig
@@ -0,0 +1,153 @@
+//! Bounded native-surface attachment records. No reader or snapshot bytes survive a call.
+const std = @import("std");
+const codec = @import("snapshot.zig");
+const record = @import("record.zig");
+const envelope = @import("envelope.zig");
+const page = @import("page.zig");
+const screen_record = @import("screen.zig");
+const io = @import("io.zig");
+const terminal_record = @import("terminal.zig");
+const Terminal = @import("../Terminal.zig");
+const Page = @import("../page.zig").Page;
+
+pub const max_ready_bytes = 512 * 1024;
+pub const max_page_bytes = 256 * 1024;
+pub const max_continuation_bytes = 256 * 1024;
+
+/// Framing/allocation preflight deliberately runs before the allocating decoder.
+/// The decoder remains responsible for checksums and semantic validation.
+pub fn validateReady(bytes: []const u8) !void {
+    if (bytes.len == 0 or bytes.len > max_ready_bytes) return error.InvalidRecord;
+    var reader: std.Io.Reader = .fixed(bytes);
+    envelope.decode(&reader) catch return error.InvalidRecord;
+    var backing: usize = 0;
+    var saw_ready = false;
+    while (reader.seek < bytes.len) {
+        const header = record.Header.decode(&reader) catch return error.InvalidRecord;
+        const payload = reader.take(header.payload_len) catch return error.InvalidRecord;
+        switch (header.tag) {
+            .terminal => {
+                var payload_reader: std.Io.Reader = .fixed(payload);
+                const t = terminal_record.Header.decode(&payload_reader) catch return error.InvalidRecord;
+                if (t.columns == 0 or t.rows == 0 or t.columns > 1000 or t.rows > 1000 or
+                    @as(usize, t.columns) * t.rows > 262144) return error.AllocationLimit;
+                // Strings allocate their advertised lengths in the core codec.
+                // Check those lengths against the actual frame before decode.
+                payload_reader.discardAll((@as(usize, t.columns) + 7) / 8 + 256 * 3) catch return error.InvalidRecord;
+                const mask = payload_reader.take(32) catch return error.InvalidRecord;
+                var overrides: usize = 0;
+                for (mask) |byte| overrides += @popCount(byte);
+                payload_reader.discardAll(overrides * 3) catch return error.InvalidRecord;
+                try skipString(&payload_reader);
+                try skipString(&payload_reader);
+            },
+            .page => {
+                backing += try pageBacking(payload, null);
+                if (backing > 32 * 1024 * 1024) return error.AllocationLimit;
+            },
+            .screen => {
+                var payload_reader: std.Io.Reader = .fixed(payload);
+                const screen_header = screen_record.Header.decode(&payload_reader) catch return error.InvalidRecord;
+                if (screen_header.saved_cursor_present)
+                    _ = screen_record.SavedCursor.decode(&payload_reader) catch return error.InvalidRecord;
+                switch (payload_reader.takeByte() catch return error.InvalidRecord) {
+                    0 => {},
+                    1 => {
+                        payload_reader.discardAll(4) catch return error.InvalidRecord;
+                        try skipString(&payload_reader);
+                    },
+                    2 => {
+                        try skipString(&payload_reader);
+                        try skipString(&payload_reader);
+                    },
+                    else => return error.InvalidRecord,
+                }
+            },
+            .continuation => if (payload.len > max_continuation_bytes) return error.AllocationLimit,
+            .ready => {
+                if (payload.len != 0 or reader.seek != bytes.len) return error.InvalidRecord;
+                saw_ready = true;
+            },
+            else => return error.InvalidRecord,
+        }
+    }
+    if (!saw_ready) return error.InvalidRecord;
+}
+
+pub fn validatePage(bytes: []const u8, cols: u16) !void {
+    if (bytes.len == 0 or bytes.len > max_page_bytes) return error.InvalidRecord;
+    var reader: std.Io.Reader = .fixed(bytes);
+    const header = record.Header.decode(&reader) catch return error.InvalidRecord;
+    if (header.tag != .page) return error.InvalidRecord;
+    const payload = reader.take(header.payload_len) catch return error.InvalidRecord;
+    if (reader.seek != bytes.len) return error.InvalidRecord;
+    _ = try pageBacking(payload, cols);
+}
+
+fn skipString(reader: *std.Io.Reader) !void {
+    const len = io.readInt(reader, u32) catch return error.InvalidRecord;
+    reader.discardAll(len) catch return error.InvalidRecord;
+}
+
+fn pageBacking(payload: []const u8, cols: ?u16) !usize {
+    var reader: std.Io.Reader = .fixed(payload);
+    const header = page.Header.decode(&reader) catch return error.InvalidRecord;
+    if (header.columns == 0 or header.rows == 0) return error.InvalidRecord;
+    if (cols) |expected| if (header.columns != expected) return error.InvalidRecord;
+    // Bound arithmetic before Page.layout, whose offsets assume native capacities.
+    if (@as(usize, header.columns) * header.rows > 262144 or
+        header.grapheme_capacity_bytes > 8 * 1024 * 1024 or
+        header.string_capacity_bytes > 8 * 1024 * 1024) return error.AllocationLimit;
+    const layout = Page.layout(.{
+        .cols = header.columns,
+        .rows = header.rows,
+        .styles = header.style_capacity,
+        .hyperlink_bytes = header.hyperlink_capacity_bytes,
+        .grapheme_bytes = header.grapheme_capacity_bytes,
+        .string_bytes = header.string_capacity_bytes,
+    });
+    if (layout.total_size > 8 * 1024 * 1024) return error.AllocationLimit;
+    return layout.total_size;
+}
+
+test "attachment validates bounded READY and independent PAGE records" {
+    const alloc = std.testing.allocator;
+    var source = try Terminal.init(std.testing.io, alloc, .{ .cols = 80, .rows = 24, .max_scrollback_bytes = null });
+    defer source.deinit(alloc);
+    for (0..1500) |_| try source.printString("history row\r\n");
+    try source.screens.active.startHyperlink("https://example.test/current", "cursor-id");
+    var output: std.Io.Writer.Allocating = .init(alloc);
+    defer output.deinit();
+    try codec.encode(alloc, &output.writer, &source, .{ .continuation = .ground });
+    const bytes = output.written();
+    var reader: std.Io.Reader = .fixed(bytes);
+    var decoder: codec.Decoder = .init(&reader);
+    var restored = try decoder.ready(alloc, std.testing.io, .{ .max_continuation_bytes = 1024 });
+    defer restored.deinit(alloc);
+    const prefix = bytes[0..reader.seek];
+    try validateReady(prefix);
+    const hostile_prefix = try alloc.dupe(u8, prefix);
+    defer alloc.free(hostile_prefix);
+    const pwd_offset = envelope.encoded_len + record.Header.len + terminal_record.Header.len + 10 + 256 * 3 + 32;
+    @memset(hostile_prefix[pwd_offset..][0..4], 0xff);
+    try std.testing.expectError(error.InvalidRecord, validateReady(hostile_prefix));
+    @memcpy(hostile_prefix, prefix);
+    @memset(hostile_prefix[envelope.encoded_len + record.Header.len ..][0..4], 0xff);
+    try std.testing.expectError(error.AllocationLimit, validateReady(hostile_prefix));
+    try std.testing.expectError(error.InvalidRecord, validateReady(bytes));
+    try std.testing.expectError(error.InvalidRecord, validateReady(prefix[0 .. prefix.len - 1]));
+    const manifest = try record.Header.decode(&reader);
+    try reader.discardAll(manifest.payload_len);
+    const start = reader.seek;
+    const next = try record.Header.decode(&reader);
+    try reader.discardAll(next.payload_len);
+    const one_page = bytes[start..reader.seek];
+    try validatePage(one_page, 80);
+    try std.testing.expectError(error.InvalidRecord, validatePage(bytes[start..], 80));
+    try std.testing.expectError(error.InvalidRecord, validatePage(one_page, 40));
+    // Allocation hints are independent of wire size and must be bounded before decode.
+    const hostile = try alloc.dupe(u8, one_page);
+    defer alloc.free(hostile);
+    @memset(hostile[record.Header.len + 12 ..][0..8], 0xff);
+    try std.testing.expectError(error.AllocationLimit, validatePage(hostile, 80));
+}
