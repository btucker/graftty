diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index 1ae766b17c1ae6fb56d6f754b7f0540539f949e1..1655d87bc872ccbe0fde571e69b5ef26959b6fc7 100644
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -1993,6 +1993,19 @@ pub const CAPI = struct {
         defer decoded.deinit(alloc);
         if (source.seek != len) return false;
 
+        // VT snapshots retain raw OSC 7 URIs, whereas native surfaces store
+        // decoded filesystem paths. Normalize while the decoded terminal is
+        // still detached, using the same acceptance rules as live OSC 7.
+        if (decoded.terminal.?.getPwd()) |pwd| {
+            if (!std.fs.path.isAbsolute(pwd)) {
+                var arena: std.heap.ArenaAllocator = .init(alloc);
+                defer arena.deinit();
+                const StreamHandler = @import("../termio/stream_handler.zig").StreamHandler;
+                const path = StreamHandler.pwdPath(arena.allocator(), pwd) catch return false;
+                decoded.terminal.?.setPwd(path orelse "") catch return false;
+            }
+        }
+
         // A search worker can hold pins to the old terminal. Join without the
         // renderer mutex, which that worker also acquires. No old pins survive.
         if (core.search) |*search| {
