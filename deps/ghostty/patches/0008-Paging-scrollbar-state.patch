Subject: Paging: scrollbar state


diff --git a/include/ghostty.h b/include/ghostty.h
index 85752e093cdb8857679e8ef094bbe6919fe8e882..5a672710dc0804d41120d1c091357878c3388099 100644
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -1300,6 +1300,8 @@ GHOSTTY_API bool ghostty_surface_read_selection(ghostty_surface_t, ghostty_text_
 GHOSTTY_API bool ghostty_surface_read_text(ghostty_surface_t,
                                               ghostty_selection_s,
                                               ghostty_text_s*);
+// Current native scrollbar, read under the renderer-state lock on the UI thread.
+GHOSTTY_API void ghostty_surface_read_scrollbar(ghostty_surface_t, ghostty_action_scrollbar_s*);
 // Current native font size, including runtime zoom. Call on the UI thread.
 GHOSTTY_API float ghostty_surface_font_size(ghostty_surface_t);
 // Read styled history without moving the viewport. offset_len returns row count.
diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index d67177c362ea8edd0ad687f0d624ceca086feded..510199398065be96e917afdd004b335bdcb925ab 100644
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -2245,6 +2245,14 @@ pub const CAPI = struct {
         ptr.deinit();
     }
 
+    /// Read the current native viewport under the renderer-state mutex.
+    export fn ghostty_surface_read_scrollbar(surface: *Surface, result: *terminal.Scrollbar.C) void {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        result.* = core.io.terminal.screens.active.pages.scrollbar().cval();
+    }
+
     /// Read on the UI thread, like inherited configuration and font actions.
     export fn ghostty_surface_font_size(surface: *Surface) f32 {
         return surface.core_surface.font_size.points;
