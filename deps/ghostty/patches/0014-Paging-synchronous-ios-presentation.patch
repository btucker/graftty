 }
 
+/// Like `draw`, but first waits (briefly) for the renderer thread to
+/// rebuild frame data from the terminal state as it is now, so the frame
+/// shows a change the caller just made, such as a viewport scroll.
+pub fn drawLatest(self: *Surface) !void {
+    self.renderer_thread.waitForFrameUpdate();
+    try self.renderer.drawFrame(true);
+}
