+
+test "Graftty history preserves blank colored rows" {
+    const alloc = std.testing.allocator;
+    var t = try Terminal.init(std.testing.io, alloc, .{ .cols = 8, .rows = 2 });
+    defer t.deinit(alloc);
+    var stream = t.vtStream();
+    defer stream.deinit();
+    stream.nextSlice("\x1b[41m\x1b[2K\x1b[0m\r\nafter");
+    var output: std.Io.Writer.Allocating = .init(alloc);
+    defer output.deinit();
+    var formatter: ScreenFormatter = .init(t.screens.active, .{
+        .emit = .vt,
+        .trim = false,
+        .preserve_styled_blank_rows = true,
+    });
+    try formatter.format(&output.writer);
+    const bytes = output.writer.buffered();
+    const newline = std.mem.indexOf(u8, bytes, "\r\n") orelse return error.TestUnexpectedResult;
+    try std.testing.expect(std.mem.indexOf(u8, bytes[0..newline], "\x1b[48;5;1m") != null);
+    output.clearRetainingCapacity();
+    formatter.opts.emit = .plain;
+    try formatter.format(&output.writer);
+    try std.testing.expectEqualStrings("\nafter", output.writer.buffered());
+}
+
+test "Graftty history copies dynamic default colors" {
+    const alloc = std.testing.allocator;
+    var t = try Terminal.init(std.testing.io, alloc, .{ .cols = 8, .rows = 2 });
+    defer t.deinit(alloc);
+    var stream = t.vtStream();
+    defer stream.deinit();
+    stream.nextSlice("\x1b]10;rgb:12/34/56\x1b\\\x1b]11;rgb:ab/cd/ef\x1b\\text");
+    var output: std.Io.Writer.Allocating = .init(alloc);
+    defer output.deinit();
+    const formatter: ScreenFormatter = .init(t.screens.active, .{
+        .emit = .vt,
+        .foreground = t.colors.foreground.get(),
+        .background = t.colors.background.get(),
+    });
+    try formatter.format(&output.writer);
+    try std.testing.expectEqualStrings(
+        "\x1b]10;rgb:12/34/56\x1b\\\x1b]11;rgb:ab/cd/ef\x1b\\text",
+        output.writer.buffered(),
+    );
