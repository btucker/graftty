diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index ac5e08b169d1ac02595f330c1047be982fca850c..d67177c362ea8edd0ad687f0d624ceca086feded 100644
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -2245,6 +2245,57 @@ pub const CAPI = struct {
         ptr.deinit();
     }
 
+    /// Read on the UI thread, like inherited configuration and font actions.
+    export fn ghostty_surface_font_size(surface: *Surface) f32 {
+        return surface.core_surface.font_size.points;
+    }
+
+    /// Format only the rows preceding the viewport into a detached VT buffer.
+    /// The source terminal's grid, cursor, viewport, and selection are unchanged.
+    export fn ghostty_surface_read_history(
+        surface: *Surface,
+        before_row: u64,
+        requested_rows: u32,
+        result: *Text,
+    ) bool {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        const t = &core.io.terminal;
+        const screen = t.screens.active;
+        const bar = screen.pages.scrollbar();
+        const history_rows = bar.total -| bar.len;
+        if (requested_rows == 0 or t.cols == 0 or before_row > history_rows) return false;
+        const count: usize = @intCast(@min(before_row, requested_rows, 262144 / @as(u32, t.cols)));
+        if (count == 0) return false;
+        const end: usize = @intCast(before_row);
+        const top = screen.pages.pin(.{ .screen = .{ .x = 0, .y = @intCast(end - count) } }) orelse return false;
+        const bottom = screen.pages.pin(.{ .screen = .{ .x = t.cols - 1, .y = @intCast(end - 1) } }) orelse return false;
+        var formatter: terminal.formatter.ScreenFormatter = .init(screen, .{
+            .emit = .vt,
+            .unwrap = false,
+            .trim = false,
+            .preserve_styled_blank_rows = true,
+            .foreground = t.colors.foreground.get(),
+            .background = t.colors.background.get(),
+            .palette = &t.colors.palette.current,
+        });
+        formatter.content = .{ .selection = .init(top, bottom, false) };
+        var buffer: std.Io.Writer.Allocating = .init(global.alloc());
+        defer buffer.deinit();
+        formatter.format(&buffer.writer) catch return false;
+        const bytes = buffer.toOwnedSliceSentinel(0) catch return false;
+        result.* = .{
+            .tl_px_x = -1,
+            .tl_px_y = -1,
+            .offset_start = 0,
+            .offset_len = @intCast(count),
+            .text = bytes.ptr,
+            .text_len = bytes.len,
+        };
+        return true;
+    }
+
