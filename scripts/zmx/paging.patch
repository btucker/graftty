+++ b/src/paging.zig
@@ -0,0 +1,333 @@
+//! Demand snapshot export. The owner serializes capture/next with terminal
+//! mutations. Checkpoints borrow terminal pages through tracked pins and must
+//! be released before the terminal is destroyed or moved.
+const std = @import("std");
+const vt = @import("ghostty-vt");
+const snap = vt.snapshot;
+const Allocator = std.mem.Allocator;
+pub const Screen = vt.ScreenSet.Key;
+const Pin = vt.PageList.Pin;
+
+pub const Checkpoint = struct {
+    alloc: Allocator,
+    terminal: *vt.Terminal,
+    /// Caller-owned mutation counter. Increment before any resize, history
+    /// rewrite, or reset whose semantics should expire retained checkpoints.
+    mutation_epoch: u64,
+    ready: []const u8,
+    screens: std.EnumMap(Screen, Cursor),
+
+    const Cursor = struct {
+        generation: usize,
+        serial_limit: u64,
+        list_epoch: u64,
+        pin: ?*Pin,
+        serial: u64,
+        remaining_rows: u64,
+        position: u64 = 0,
+        cached: ?Page = null,
+    };
+
+    pub const Page = struct {
+        /// Caller must copy before another request for this screen or deinit.
+        bytes: []const u8,
+        position: u64,
+        rows: usize,
+        remaining_rows: u64,
+    };
+
+    pub const Reply = union(enum) { page: Page, done };
+
+    /// Encode only active screen backing pages and parser continuation. The
+    /// history row counters are cached by PageList. No historical list walk,
+    /// clone, compression, or history encoding occurs during capture.
+    pub fn capture(
+        alloc: Allocator,
+        terminal: *vt.Terminal,
+        continuation: snap.Continuation,
+        mutation_epoch: u64,
+    ) !Checkpoint {
+        var result: Checkpoint = .{
+            .alloc = alloc,
+            .terminal = terminal,
+            .mutation_epoch = mutation_epoch,
+            .ready = &.{},
+            .screens = .init(.{}),
+        };
+        errdefer result.deinit();
+        var it = terminal.screens.all.iterator();
+        while (it.next()) |entry| {
+            const screen = terminal.screens.get(entry.key).?;
+            const first = screen.pages.getTopLeft(.active).node;
+            var resident_rows: u64 = 0;
+            var node: ?@TypeOf(first) = first;
+            while (node) |current| : (node = current.next)
+                resident_rows += current.rows();
+            const previous = first.prev;
+            result.screens.put(entry.key, .{
+                .generation = terminal.screens.generation(entry.key),
+                .serial_limit = screen.pages.page_serial,
+                .list_epoch = screen.pages.page_serial_epoch,
+                .pin = if (previous) |p| try screen.pages.trackPin(.{ .node = p }) else null,
+                .serial = if (previous) |p| p.serial else 0,
+                .remaining_rows = screen.pages.total_rows - resident_rows,
+            });
+        }
+
+        var output: std.Io.Writer.Allocating = .init(alloc);
+        defer output.deinit();
+        var writer: snap.record.Writer = .init(alloc, &output.writer);
+        defer writer.deinit();
+        try snap.continuation.validate(continuation);
+        try snap.envelope.encode(writer.writer());
+        try snap.terminal.encode(terminal, &writer);
+        it = terminal.screens.all.iterator();
+        while (it.next()) |entry|
+            try snap.screen.encode(terminal.screens.get(entry.key).?, entry.key, &writer);
+        try snap.continuation.encode(continuation, &writer);
+        try snap.checkpoint.encode(.ready, &writer);
+        result.ready = try alloc.dupe(u8, output.written());
+        return result;
+    }
+
+    pub fn historyRows(self: *const Checkpoint, key: Screen) u64 {
+        return if (self.screens.get(key)) |cursor| cursor.remaining_rows else 0;
+    }
+
+    pub fn deinit(self: *Checkpoint) void {
+        var it = self.screens.iterator();
+        while (it.next()) |entry| {
+            if (entry.value.cached) |cached| self.alloc.free(cached.bytes);
+            // Screen removal destroys its pins. Check identity first, before
+            // touching either the borrowed pin or the replacement screen.
+            if (self.terminal.screens.generation(entry.key) != entry.value.generation) continue;
+            if (self.terminal.screens.get(entry.key)) |screen| {
+                if (entry.value.pin) |pin| screen.pages.untrackPin(pin);
+            }
+        }
+        self.alloc.free(self.ready);
+        self.* = undefined;
+    }
+
+    /// Fetch the next complete page, newest first. Retrying the most recently
+    /// returned position returns identical bytes without advancing. One encoded
+    /// page per screen remains cached until the next successful request.
+    pub fn next(
+        self: *Checkpoint,
+        key: Screen,
+        position: u64,
+        byte_budget: usize,
+        mutation_epoch: u64,
+    ) !Reply {
+        const cursor = self.screens.getPtr(key) orelse return error.UnknownScreen;
+        if (mutation_epoch != self.mutation_epoch or
+            self.terminal.screens.generation(key) != cursor.generation)
+            return error.CheckpointExpired;
+        const screen = self.terminal.screens.get(key) orelse return error.CheckpointExpired;
+        if (screen.pages.page_serial_epoch != cursor.list_epoch) return error.CheckpointExpired;
+        if (cursor.pin) |pin| {
+            if (pin.garbage or pin.node.serial != cursor.serial) return error.CheckpointExpired;
+        }
+
+        if (cursor.cached) |cached| {
+            if (position == cached.position) {
+                if (cached.bytes.len > byte_budget) return error.PageExceedsBudget;
+                return .{ .page = cached };
+            }
+        }
+        if (position != cursor.position) return error.OutOfOrder;
+        if (cursor.remaining_rows == 0) return .done;
+
+        const pin = cursor.pin orelse return error.CheckpointExpired;
+        if (pin.garbage or pin.y != 0 or pin.x != 0 or
+            pin.node.serial != cursor.serial or pin.node.serial >= cursor.serial_limit)
+            return error.CheckpointExpired;
+        const rows = pin.node.rows();
+        if (rows > cursor.remaining_rows) return error.CheckpointExpired;
+        const previous = pin.node.prev;
+        // Do not return a truncated history as successful completion when
+        // pruning removed the older suffix while this page remained alive.
+        if (previous == null and rows != cursor.remaining_rows)
+            return error.CheckpointExpired;
+        if (previous) |p| {
+            if (p.serial >= cursor.serial_limit) return error.CheckpointExpired;
+        }
+
+        var output: std.Io.Writer.Allocating = .init(self.alloc);
+        defer output.deinit();
+        var writer: snap.record.Writer = .init(self.alloc, &output.writer);
+        defer writer.deinit();
+        var preserved = try pin.node.pagePreservingState(self.alloc);
+        defer preserved.deinit();
+        try snap.page.encode(preserved.page(), &writer);
+        if (output.written().len > byte_budget) return error.PageExceedsBudget;
+        const bytes = try self.alloc.dupe(u8, output.written());
+        const reply: Page = .{
+            .bytes = bytes,
+            .position = position,
+            .rows = rows,
+            .remaining_rows = cursor.remaining_rows - rows,
+        };
+        if (cursor.cached) |cached| self.alloc.free(cached.bytes);
+        cursor.cached = reply;
+        cursor.remaining_rows = reply.remaining_rows;
+        cursor.position += 1;
+        if (previous) |p| {
+            pin.* = .{ .node = p };
+            cursor.serial = p.serial;
+        }
+        // Retain the final source pin until deinit so a cached-page retry
+        // can still detect subsequent clear/prune/reset invalidation.
+        return .{ .page = reply };
+    }
+};
+
+test "paging capture stays bounded and demand pages preserve 100000 rows plus live output" {
+    const alloc = std.testing.allocator;
+    var term = try vt.Terminal.init(std.testing.io, alloc, .{
+        .cols = 80,
+        .rows = 24,
+        .max_scrollback_bytes = null,
+        .max_scrollback_lines = null,
+    });
+    defer term.deinit(alloc);
+    var stream = term.vtStream();
+    defer stream.deinit();
+    for (0..100_000) |i| {
+        var buf: [40]u8 = undefined;
+        stream.nextSlice(try std.fmt.bufPrint(&buf, "line-{d:0>6}\r\n", .{i}));
+    }
+    const pins_before = term.screens.active.pages.countTrackedPins();
+    var checkpoint = try Checkpoint.capture(alloc, &term, .ground, 0);
+    defer checkpoint.deinit();
+    try std.testing.expect(checkpoint.ready.len < 64 * 1024);
+    try std.testing.expectEqual(pins_before + 1, term.screens.active.pages.countTrackedPins());
+
+    var source: std.Io.Reader = .fixed(checkpoint.ready);
+    var decoder = snap.Decoder.init(&source);
+    var decoded = try decoder.ready(alloc, std.testing.io, .{ .max_continuation_bytes = 4096 });
+    defer decoded.deinit(alloc);
+    var restored = decoded.toOwned();
+    defer restored.deinit(alloc);
+    var live = restored.vtStream();
+    defer live.deinit();
+    try std.testing.expect(restored.screens.active.pages.total_rows < 2000);
+
+    // No history is requested while the terminal is already exchanging output.
+    stream.nextSlice("live-before-history\r\n");
+    live.nextSlice("live-before-history\r\n");
+    try std.testing.expectError(error.OutOfOrder, checkpoint.next(.primary, 1, 1024 * 1024, 0));
+    try std.testing.expectError(error.PageExceedsBudget, checkpoint.next(.primary, 0, 1, 0));
+    var position: u64 = 0;
+    while (true) {
+        const reply = try checkpoint.next(.primary, position, 1024 * 1024, 0);
+        switch (reply) {
+            .done => break,
+            .page => |page| {
+                const retry = (try checkpoint.next(.primary, position, 1024 * 1024, 0)).page;
+                try std.testing.expectEqualSlices(u8, page.bytes, retry.bytes);
+                var page_reader: std.Io.Reader = .fixed(page.bytes);
+                try std.testing.expectEqual(page.rows, try snap.history.decodePage(&page_reader, alloc, restored.screens.active));
+                try std.testing.expectEqual(page.bytes.len, page_reader.seek);
+                stream.nextSlice("live-between-pages\r\n");
+                live.nextSlice("live-between-pages\r\n");
+                position += 1;
+            },
+        }
+    }
+    try std.testing.expect(position > 100);
+    try std.testing.expectEqual(pins_before + 1, term.screens.active.pages.countTrackedPins());
+    const original = try term.screens.active.dumpStringAlloc(alloc, .{ .screen = .{} });
+    defer alloc.free(original);
+    const imported = try restored.screens.active.dumpStringAlloc(alloc, .{ .screen = .{} });
+    defer alloc.free(imported);
+    try std.testing.expectEqualStrings(original, imported);
+}
+
+test "paging rejects resize roundtrip clear and explicit epoch changes" {
+    const alloc = std.testing.allocator;
+    for (0..3) |scenario| {
+        var term = try vt.Terminal.init(std.testing.io, alloc, .{
+            .cols = 80,
+            .rows = 24,
+            .max_scrollback_bytes = null,
+            .max_scrollback_lines = null,
+        });
+        defer term.deinit(alloc);
+        var stream = term.vtStream();
+        defer stream.deinit();
+        for (0..2000) |_| stream.nextSlice("row\r\n");
+        var checkpoint = try Checkpoint.capture(alloc, &term, .ground, 0);
+        defer checkpoint.deinit();
+        switch (scenario) {
+            0 => {
+                try term.resize(alloc, .{ .cols = 40, .rows = 24 });
+                try term.resize(alloc, .{ .cols = 80, .rows = 24 });
+            },
+            1 => stream.nextSlice("\x1b[3J"),
+            else => {},
+        }
+        try std.testing.expectError(error.CheckpointExpired, checkpoint.next(.primary, 0, 1024 * 1024, if (scenario == 2) 1 else 0));
+    }
+}
+
+test "paging releases canceled checkpoint pins and validates cached retries after history clear" {
+    const alloc = std.testing.allocator;
+    var term = try vt.Terminal.init(std.testing.io, alloc, .{
+        .cols = 80,
+        .rows = 24,
+        .max_scrollback_bytes = null,
+        .max_scrollback_lines = null,
+    });
+    defer term.deinit(alloc);
+    var stream = term.vtStream();
+    defer stream.deinit();
+    for (0..2000) |_| stream.nextSlice("row\r\n");
+    const before = term.screens.active.pages.countTrackedPins();
+    {
+        var checkpoint = try Checkpoint.capture(alloc, &term, .ground, 0);
+        defer checkpoint.deinit();
+        _ = try checkpoint.next(.primary, 0, 1024 * 1024, 0);
+        try std.testing.expectEqual(before + 1, term.screens.active.pages.countTrackedPins());
+        stream.nextSlice("\x1b[3J");
+        try std.testing.expectError(error.CheckpointExpired, checkpoint.next(.primary, 0, 1024 * 1024, 0));
+    }
+    try std.testing.expectEqual(before, term.screens.active.pages.countTrackedPins());
+
+    // Empty history completes without an allocated pin or PAGE record.
+    var empty = try Checkpoint.capture(alloc, &term, .ground, 0);
+    defer empty.deinit();
+    try std.testing.expectEqual(@as(u64, 0), empty.historyRows(.primary));
+    try std.testing.expect(try empty.next(.primary, 0, 0, 0) == .done);
+    try std.testing.expectEqual(before, term.screens.active.pages.countTrackedPins());
+}
+
+test "paging can capture alternate screen and expire after screen replacement" {
+    const alloc = std.testing.allocator;
+    var term = try vt.Terminal.init(std.testing.io, alloc, .{
+        .cols = 80,
+        .rows = 24,
+        .max_scrollback_bytes = null,
+        .max_scrollback_lines = null,
+    });
+    defer term.deinit(alloc);
+    var stream = term.vtStream();
+    defer stream.deinit();
+    for (0..2000) |_| stream.nextSlice("primary\r\n");
+    stream.nextSlice("\x1b[?1049hALTERNATE");
+    var checkpoint = try Checkpoint.capture(alloc, &term, .ground, 0);
+    defer checkpoint.deinit();
+    var reader: std.Io.Reader = .fixed(checkpoint.ready);
+    var decoder = snap.Decoder.init(&reader);
+    var decoded = try decoder.ready(alloc, std.testing.io, .{ .max_continuation_bytes = 1024 });
+    defer decoded.deinit(alloc);
+    try std.testing.expectEqual(Screen.alternate, decoded.terminal.?.screens.active_key);
+    try std.testing.expect(checkpoint.historyRows(.primary) > 0);
+    try std.testing.expect(try checkpoint.next(.alternate, 0, 0, 0) == .done);
+    _ = try term.switchScreen(.primary);
+    term.screens.remove(alloc, .alternate);
+    _ = try term.switchScreen(.alternate);
+    try std.testing.expectError(error.CheckpointExpired, checkpoint.next(.alternate, 0, 1024 * 1024, 0));
+    // The independent primary page remains fetchable while alternate is active.
+    try std.testing.expect(try checkpoint.next(.primary, 0, 1024 * 1024, 0) == .page);
+}
