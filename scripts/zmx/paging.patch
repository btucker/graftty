+    // Socket EOF can also mean a detached client or a failed transport. Only
+    // a reaped child proves the terminal process exited. Flush its explicit
+    // status after earlier output, without waiting forever for stalled peers.
+    fn finishPagedPTYExit(self: *Daemon, gpa: std.mem.Allocator, io: std.Io) !void {
+        const has_paged = for (self.clients.items) |client| {
+            if (client.is_terminal and client.capabilities.supportsPaging()) break true;
+        } else false;
+        if (!has_paged) return;
+        const reap_deadline = std.Io.Timestamp.now(io, .awake).toMilliseconds() + 500;
+        var exit_status: ?i32 = null;
+        while (std.Io.Timestamp.now(io, .awake).toMilliseconds() < reap_deadline) {
+            var raw_status: c_int = 0;
+            const reaped = std.c.waitpid(self.pid, &raw_status, @intCast(std.c.W.NOHANG));
+            if (reaped == self.pid) {
+                const status: u32 = @bitCast(raw_status);
+                self.pty_reaped = true;
+                exit_status = if (std.c.W.IFEXITED(status))
+                    std.c.W.EXITSTATUS(status)
+                else if (std.c.W.IFSIGNALED(status))
+                    128 + @as(i32, @intCast(@intFromEnum(std.c.W.TERMSIG(status))))
+                else
+                    1;
+                break;
+            }
+            std.Io.sleep(io, std.Io.Duration.fromMilliseconds(10), .awake) catch return;
+        }
+        const status = exit_status orelse return;
+        try self.queuePagedExit(gpa, status);
+        const flush_deadline = std.Io.Timestamp.now(io, .awake).toMilliseconds() + 1000;
+        while (std.Io.Timestamp.now(io, .awake).toMilliseconds() < flush_deadline) {
+            var pending = false;
+            for (self.clients.items) |client| {
+                if (!client.capabilities.supportsPaging() or client.write_buf.items.len == 0) continue;
+                var fds = [_]lib_posix.pollfd{.{ .fd = client.socket_fd, .events = lib_posix.POLL.OUT, .revents = 0 }};
+                _ = try lib_posix.poll(&fds, 0);
+                if (fds[0].revents & lib_posix.POLL.OUT != 0) {
+                    const n: usize = lib_posix.write(client.socket_fd, client.write_buf.items) catch |err| blk: {
+                        if (err == error.WouldBlock) break :blk 0;
+                        client.write_buf.clearRetainingCapacity();
+                        break :blk 0;
+                    };
+                    if (n > 0) try client.write_buf.replaceRange(gpa, 0, n, &.{});
+                }
+                pending = pending or client.write_buf.items.len > 0;
+            }
+            if (!pending) break;
+            std.Io.sleep(io, std.Io.Duration.fromMilliseconds(10), .awake) catch return;
+        }
+    }
