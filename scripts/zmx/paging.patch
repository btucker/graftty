+    fn queuePagedExit(self: *Daemon, gpa: std.mem.Allocator, status: i32) !void {
+        for (self.clients.items) |client| {
+            if (!client.is_terminal or !client.capabilities.supportsPaging()) continue;
+            try ipc.appendMessage(gpa, &client.write_buf, .PagedEnded, std.mem.asBytes(&status));
+            client.has_pending_output = true;
+        }
+    }
