+    try std.testing.expectEqual(@as(usize, 48), @sizeOf(PagedPage));
+    try std.testing.expectEqual(@as(u8, 26), @intFromEnum(Tag.PagedAttach));
+    try std.testing.expect(!(Capabilities{}).supportsPaging());
+}
