index 3ba93e2..a89359b 100644
--- a/src/signal.zig
+++ b/src/signal.zig
@@ -6,9 +6,10 @@ const lib_posix = @import("posix.zig");
 /// never surfaces; the handler writes a byte here and poll() wakes on POLLIN.
 pub var sig_pipe: [2]lib_posix.fd_t = .{ -1, -1 };
 
-pub fn wakeSignalPipe(_: lib_posix.SIG, _: *const lib_posix.siginfo_t, _: ?*anyopaque) callconv(.c) void {
+pub fn wakeSignalPipe(sig: lib_posix.SIG, _: *const lib_posix.siginfo_t, _: ?*anyopaque) callconv(.c) void {
     const saved = std.c._errno().*;
-    _ = std.c.write(sig_pipe[1], "x", 1);
+    const byte = [_]u8{@intCast(@intFromEnum(sig))};
+    _ = std.c.write(sig_pipe[1], &byte, 1);
     std.c._errno().* = saved;
 }
 
@@ -37,10 +38,88 @@ pub fn openSignalPipe() !void {
     sig_pipe = try lib_posix.pipe2(.{ .CLOEXEC = true, .NONBLOCK = true });
 }
 
-pub fn drainSignalPipe() void {
+pub fn closeSignalPipe() void {
+    const fds = sig_pipe;
+    sig_pipe = .{ -1, -1 };
+    lib_posix.close(fds[0]);
+    lib_posix.close(fds[1]);
+}
+
+pub fn drainSignalPipe() error{ Sighup, Sigint, Sigterm }!void {
     var b: [16]u8 = undefined;
     while (true) {
         const n = lib_posix.read(sig_pipe[0], &b) catch return;
         if (n == 0) return;
+        for (b[0..n]) |sig| {
+            switch (sig) {
+                @intFromEnum(lib_posix.SIG.HUP) => return error.Sighup,
+                @intFromEnum(lib_posix.SIG.INT) => return error.Sigint,
+                @intFromEnum(lib_posix.SIG.TERM) => return error.Sigterm,
+                else => {},
+            }
+        }
+    }
+}
+
+/// Return SIGTERM/SIGHUP/SIGINT to their default action. Once the client loop
+/// closes the signal pipe its wake handler can no longer report them, so a
+/// later signal (for example, while a restore write blocks) must still kill.
+pub fn restoreDefaultHandlers() void {
+    const act: lib_posix.Sigaction = .{
+        .handler = .{ .handler = lib_posix.SIG.DFL },
+        .mask = lib_posix.sigemptyset(),
+        .flags = 0,
+    };
+    for ([_]lib_posix.SIG{ .TERM, .HUP, .INT }) |sig| lib_posix.sigaction(sig, &act, null);
+}
+
+pub fn reraise(sig: lib_posix.SIG) noreturn {
+    const act: lib_posix.Sigaction = .{
+        .handler = .{ .handler = lib_posix.SIG.DFL },
+        .mask = lib_posix.sigemptyset(),
+        .flags = 0,
+    };
+    lib_posix.sigaction(sig, &act, null);
+
+    var mask = lib_posix.sigemptyset();
+    lib_posix.sigaddset(&mask, sig);
+    lib_posix.sigprocmask(lib_posix.SIG.UNBLOCK, &mask, null);
+    std.posix.raise(sig) catch {};
+    std.process.exit(128 + @as(u8, @intCast(@intFromEnum(sig))));
+}
+
+test "drainSignalPipe reports termination signals after wake-only signals" {
+    try openSignalPipe();
+    defer closeSignalPipe();
+    _ = try lib_posix.write(sig_pipe[1], &[_]u8{@intCast(@intFromEnum(lib_posix.SIG.WINCH))});
+    try drainSignalPipe();
+    inline for (.{
+        .{ lib_posix.SIG.HUP, error.Sighup },
+        .{ lib_posix.SIG.INT, error.Sigint },
+        .{ lib_posix.SIG.TERM, error.Sigterm },
+    }) |case| {
+        _ = try lib_posix.write(sig_pipe[1], &[_]u8{
+            @intCast(@intFromEnum(lib_posix.SIG.WINCH)),
+            @intCast(@intFromEnum(case[0])),
+        });
+        try std.testing.expectError(case[1], drainSignalPipe());
+        drainSignalPipe() catch {};
+    }
+}
+
+test "closeSignalPipe resets the descriptors" {
+    try openSignalPipe();
+    closeSignalPipe();
+    try std.testing.expectEqual(@as(lib_posix.fd_t, -1), sig_pipe[0]);
+    try std.testing.expectEqual(@as(lib_posix.fd_t, -1), sig_pipe[1]);
+}
+
+test "restoreDefaultHandlers stops a closed pipe from swallowing termination signals" {
+    for ([_]lib_posix.SIG{ .TERM, .HUP, .INT }) |sig| installWakeHandler(@intCast(@intFromEnum(sig)));
+    restoreDefaultHandlers();
+    for ([_]lib_posix.SIG{ .TERM, .HUP, .INT }) |sig| {
+        var current: lib_posix.Sigaction = undefined;
+        lib_posix.sigaction(sig, null, &current);
+        try std.testing.expectEqual(lib_posix.SIG.DFL, current.handler.handler);
     }
 }
