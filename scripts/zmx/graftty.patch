+test "Graftty wire extensions preserve legacy resize size" {
+    try std.testing.expectEqual(@as(usize, 4), @sizeOf(Resize));
+    try std.testing.expectEqual(@as(usize, 4), @sizeOf(PixelSize));
+    try std.testing.expectEqual(@as(usize, 8), @sizeOf(Capabilities));
+    try std.testing.expectEqual(@as(u8, 18), @intFromEnum(Tag.Capabilities));
+    try std.testing.expectEqual(@as(u8, 19), @intFromEnum(Tag.PixelSize));
+
+    const capabilities = Capabilities{ .bits = Capabilities.pixel_size };
+    try std.testing.expect(capabilities.supportsPixelSize());
+    try std.testing.expect(!(Capabilities{}).supportsPixelSize());
+}
