+const PixelProtocol = enum { none, legacy, current };
+
+fn appendTerminalSize(
+    gpa: std.mem.Allocator,
+    write_buf: *std.ArrayList(u8),
+    size: ipc.TerminalSize,
+    pixel_protocol: PixelProtocol,
+) !void {
+    const pixels = size.pixelSize();
+    switch (pixel_protocol) {
+        .none => {},
+        .legacy => try ipc.appendMessage(gpa, write_buf, .EnvGet, std.mem.asBytes(&pixels)),
+        .current => try ipc.appendMessage(gpa, write_buf, .PixelSize, std.mem.asBytes(&pixels)),
+    }
+    const resize = size.resize();
+    try ipc.appendMessage(gpa, write_buf, .Resize, std.mem.asBytes(&resize));
