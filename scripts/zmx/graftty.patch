+fn appendTerminalSnapshot(
+    gpa: std.mem.Allocator,
+    client: *Client,
+    term: *const ghostty_vt.Terminal,
+    vt_stream: *const ghostty_vt.TerminalStream,
+) !void {
+    var continuation_buf: std.Io.Writer.Allocating = .init(gpa);
+    defer continuation_buf.deinit();
+    if (!vt_stream.ground()) try vt_stream.writeContinuation(&continuation_buf.writer);
+
+    var snap_buf: std.Io.Writer.Allocating = .init(gpa);
+    defer snap_buf.deinit();
+    const continuation: snapshot.Continuation = if (continuation_buf.written().len == 0)
+        .ground
+    else
