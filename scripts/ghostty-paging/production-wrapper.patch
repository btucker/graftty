+import Foundation
+import GhosttyKit
+
+/// Adapts existing text clipboard support to the renderer's length-based ABI.
+enum TerminalClipboardText {
+    static func string(from contents: UnsafePointer<ghostty_clipboard_content_s>?, count: Int) -> String? {
+        guard let contents, count > 0 else { return nil }
+        for content in UnsafeBufferPointer(start: contents, count: count) {
+            guard let mime = content.mime, String(cString: mime) == "text/plain",
+                  let data = content.data else { continue }
+            let bytes = UnsafeRawPointer(data).assumingMemoryBound(to: UInt8.self)
+            return String(decoding: UnsafeBufferPointer(start: bytes, count: content.len), as: UTF8.self)
+        }
+        return nil
+    }
+
+    static func accepts(_ mimes: UnsafePointer<UnsafePointer<CChar>?>?, count: Int) -> Bool {
+        guard let mimes, count > 0 else { return false }
+        return UnsafeBufferPointer(start: mimes, count: count).contains { mime in
+            mime.map { String(cString: $0) == "text/plain" } ?? false
+        }
+    }
+
+    static func withCompletion<Result>(
+        text: String,
+        confirmed: Bool,
+        listOnly: Bool = false,
+        _ body: (UnsafePointer<ghostty_clipboard_complete_s>) -> Result
+    ) -> Result {
+        "text/plain".withCString { mime in
+            text.withCString { data in
+                var content = ghostty_clipboard_content_s(mime: mime, data: data, len: text.utf8.count)
+                return withUnsafePointer(to: &content) { contentPointer in
+                    let available: [UnsafePointer<CChar>?] = [mime]
+                    return available.withUnsafeBufferPointer { types in
+                        var completion = ghostty_clipboard_complete_s(
+                            contents: listOnly ? nil : contentPointer,
+                            contents_len: listOnly ? 0 : 1,
+                            available: types.baseAddress,
+                            available_len: types.count,
+                            confirmed: confirmed,
+                            remember: false
+                        )
+                        return withUnsafePointer(to: &completion, body)
+                    }
+                }
+            }
+        }
+    }
+}
