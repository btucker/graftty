+@testable import GhosttyTerminal
+import Foundation
+import GhosttyKit
+import Testing
+
+struct TerminalClipboardPayloadTests {
+    @Test
+    func `clipboard text respects explicit byte length without terminator`() {
+        let bytes: [CChar] = [65, 0, 66, 67]
+        "text/plain".withCString { mime in
+            bytes.withUnsafeBufferPointer { data in
+                var content = ghostty_clipboard_content_s(mime: mime, data: data.baseAddress, len: 3)
+                withUnsafePointer(to: &content) { pointer in
+                    #expect(TerminalClipboardText.string(from: pointer, count: 1) == "A\0B")
+                }
+            }
+        }
+    }
+
+    @Test
+    func `clipboard completion preserves text bytes and confirmation`() {
+        TerminalClipboardText.withCompletion(text: "A\0B", confirmed: true) { pointer in
+            let completion = pointer.pointee
+            #expect(completion.confirmed)
+            #expect(!completion.remember)
+            #expect(completion.contents_len == 1)
+            #expect(completion.contents?.pointee.len == 3)
+            #expect(TerminalClipboardText.string(from: completion.contents, count: completion.contents_len) == "A\0B")
+            #expect(TerminalClipboardText.accepts(completion.available, count: completion.available_len))
+        }
+    }
+
+    @Test
+    func `clipboard type listing contains no clipboard data`() {
+        TerminalClipboardText.withCompletion(text: "contents", confirmed: false, listOnly: true) { pointer in
+            #expect(pointer.pointee.contents == nil)
+            #expect(pointer.pointee.contents_len == 0)
+            #expect(TerminalClipboardText.accepts(pointer.pointee.available, count: pointer.pointee.available_len))
+        }
+    }
